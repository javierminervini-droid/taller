{
  "name": "taller-gestion",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:client",
    "dev:client": "npm run dev --prefix client",
    "dev:api": "cd backend && go run ./cmd/api",
    "legacy:server": "node --watch server/index.js",
    "build": "npm run build --prefix client",
    "qa": "node scripts/qa.mjs",
    "postinstall": "npm install --prefix client --ignore-scripts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^8.2.0",
    "bcryptjs": "^3.0.2",
    "fastify": "^5.6.0",
    "jsonwebtoken": "^9.0.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "description": "React client + Go API (backend/). Legacy Node API: npm run legacy:server"
}
