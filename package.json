{
  "name": "taller-gestion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm run dev --prefix client",
    "start": "node server/index.js",
    "build": "npm run build --prefix client",
    "qa": "node scripts/qa.mjs",
    "postinstall": "npm install --prefix client --ignore-scripts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^8.2.0",
    "bcryptjs": "^3.0.2",
    "fastify": "^5.6.0",
    "jsonwebtoken": "^9.0.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
